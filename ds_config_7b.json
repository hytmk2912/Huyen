{
  "train_micro_batch_size_per_gpu": 1,
  "gradient_accumulation_steps": 32,
  "fp16": { "enabled": false },
  "bf16": { "enabled": false },
  "optimizer": { "type": "AdamW", "params": { "lr": 1.5e-4, "betas": [0.9, 0.95], "weight_decay": 0.1 } },
  "scheduler": { "type": "WarmupDecayLR", "params": { "warmup_min_lr": 0, "warmup_max_lr": 1.5e-4, "warmup_num_steps": 200, "total_num_steps": 100000 } },
  "gradient_clipping": 1.0,
  "wall_clock_breakdown": false,
  "aio": {
    "block_size": 1048576,
    "queue_depth": 8,
    "thread_count": 4,
    "single_submit": false,
    "overlap_events": true
  },
  "zero_optimization": {
    "stage": 3,
    "offload_param": { "device": "nvme", "nvme_path": "/root/ai-agent/nvme_offload", "pin_memory": false },
    "offload_optimizer": { "device": "nvme", "nvme_path": "/root/ai-agent/nvme_offload", "pin_memory": false },
    "overlap_comm": true,
    "contiguous_gradients": true,
    "reduce_bucket_size": 2.5e7,
    "stage3_prefetch_bucket_size": 2.5e7,
    "stage3_param_persistence_threshold": 1e5,
    "stage3_max_live_parameters": 2.5e7,
    "stage3_max_reuse_distance": 2.5e7,
    "stage3_gather_16bit_weights_on_model_save": false
  }
}
