  "max_local_storage_gb": 500,
  "max_bandwidth_mbps": 100,
  "retention": {
    "raw_retention": "keep",
    "processed_retention": "keep",
    "shard_retention": "keep"
  },
  "upload": {
    "enabled": true,
    "retries": 3
  },
