{
  "_comment": "QLoRA cho model chính 27B: trọng số nén 4-bit NF4 (khoảng 15 GB thay vì 54 GB ở bf16), chạy được trên GPU 24 GB. Xem ước lượng bằng --dry-run.",
  "base_model": "primary",
  "models_config": "configs/models/platform.json",
  "dataset_path": "data/processed/hf_sft/sft.jsonl",
  "output_dir": ".runs/sft-qlora-27b",
  "method": "qlora",
  "lora": {
    "r": 16,
    "alpha": 32,
    "dropout": 0.05,
    "target_modules": "all-linear"
  },
  "seed": 17,
  "epochs": 1,
  "learning_rate": 0.0001,
  "per_device_batch_size": 1,
  "gradient_accumulation_steps": 8,
  "max_length": 2048,
  "gradient_checkpointing": true,
  "save_steps": 200,
  "save_total_limit": 3,
  "logging_steps": 10,
  "resume": true,
  "require_gpu": true,
  "eval_cases": "data/eval/vi_trading_eval.jsonl",
  "eval_max_new_tokens": 128
}
