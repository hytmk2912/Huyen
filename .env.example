# Mẫu biến môi trường. Chép thành .env (đã nằm trong .gitignore) rồi điền giá trị trên máy của bạn; KHÔNG commit file .env.
# Trên Colab/Kaggle: không dùng file này, thêm vào Secrets (Colab: biểu tượng chìa khóa, bật Notebook access).
# Code chỉ đọc các biến này qua local_ai/config/secrets.py; thiếu biến bắt buộc thì lệnh dừng và báo tên biến.

# Token Hugging Face (huggingface.co/settings/tokens). Quyền Read đủ để đọc dataset/model công khai hoặc riêng tư;
# quyền Write (fine-grained, chỉ cho repo của bạn) khi cần đẩy adapter, báo cáo chấm hay số đo lên Hub. Bỏ trống nếu chỉ đọc dữ liệu công khai.
HF_TOKEN=

# Token của gateway HTTP local (local_ai.runtime.gateway), ít nhất 16 ký tự. Chỉ cần khi bật gateway (mặc định tắt).
# Tạo ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOCAL_AI_GATEWAY_TOKEN=

# (Tùy chọn) thêm một thư mục được phép ghi dữ liệu tải về, ngoài data/ của repo và thư mục tạm. Không phải secret.
LOCAL_AI_DATA_DIR=
